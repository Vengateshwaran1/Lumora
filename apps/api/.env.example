# For running the API directly on the host (uv run uvicorn ...), outside
# Docker Compose. Copy to apps/api/.env. When running via `docker compose
# up`, these values are instead injected by docker-compose.yml using
# service names (postgres, redis, qdrant) — do not use this file for that.

ENVIRONMENT=development
LOG_LEVEL=INFO

API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]

SECRET_KEY=change_me_in_production

POSTGRES_USER=lumora
POSTGRES_PASSWORD=lumora_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lumora

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=lumora_chunks

REPO_STORAGE_PATH=./.data/repos
MAX_FILE_SIZE_BYTES=1000000

# "deterministic" needs no external services; switch to "ollama" once
# Ollama is running locally with the models below pulled (see README).
EMBEDDING_PROVIDER=deterministic
EMBEDDING_DIMENSIONS=768
CHAT_PROVIDER=extractive

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen3

# "cross_encoder" downloads model weights from Hugging Face on first use.
RERANKER_PROVIDER=none
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# GitHub webhook HMAC secret — every webhook is rejected while this is
# empty (fail closed, not "skip verification"). Any non-empty value works
# for local testing against a manually signed request.
GITHUB_WEBHOOK_SECRET=
# Optional — only needed to mint installation tokens for private repos.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Optional personal access token — fallback for private-repo clone +
# issue-fetch auth when no GitHub App installation is configured
# (Milestone 3). Needs `repo` scope for private repos.
GITHUB_TOKEN=

# "template" needs no LLM at all (Milestone 3 Planning Agent). Switch to
# "ollama" once Ollama is running with ollama_chat_model pulled.
PLANNING_PROVIDER=template
