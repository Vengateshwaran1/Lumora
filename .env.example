# Root environment file — consumed by docker-compose.yml for service
# credentials and host port mappings. Copy to `.env` before running
# `docker compose up`.
#
# This file does NOT configure application runtime behavior (DB URLs,
# CORS, etc.) — those are set per-service inside docker-compose.yml using
# the service names on the compose network (e.g. `postgres`, `redis`).
# For running apps/api or apps/web directly on the host (outside Docker),
# see apps/api/.env.example and apps/web/.env.example instead.

# --- General ---
ENVIRONMENT=development

# --- PostgreSQL ---
POSTGRES_USER=lumora
POSTGRES_PASSWORD=lumora_dev_password
POSTGRES_DB=lumora
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Qdrant ---
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=lumora_admin
MINIO_ROOT_PASSWORD=lumora_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- API (FastAPI) ---
API_PORT=8000
SECRET_KEY=change_me_in_production

# --- Web (Vite dev server) ---
WEB_PORT=5173
