{
  "name": "lumora",
  "private": true,
  "version": "0.1.0",
  "description": "Lumora — autonomous AI software engineering platform",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "build:web": "npm run build --workspace apps/web",
    "lint:web": "npm run lint --workspace apps/web",
    "typecheck:web": "npm run typecheck --workspace apps/web",
    "format:check:web": "npm run format:check --workspace apps/web",
    "build:shared-types": "npm run build --workspace packages/shared-types"
  }
}
